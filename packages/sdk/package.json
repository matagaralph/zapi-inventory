{
  "name": "zapi-inventory",
  "version": "0.0.0",
  "private": false,
  "description": "TypeScript SDK for Zoho Inventory Rest API.",
  "homepage": "https://github.com/matagaralph/zapi-inventory#readme",
  "bugs": {
    "url": "https://github.com/matagaralph/zapi-inventory/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matagaralph/zapi-inventory.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run scripts/build.ts"
  },
  "dependencies": {
    "xior": "^0.8.4"
  },
  "devDependencies": {
    "@zapi-inventory/typegen": "workspace:*"
  },
  "packageManager": "bun@1.4.0"
}
