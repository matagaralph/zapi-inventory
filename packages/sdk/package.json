{
  "name": "zapi-inventory",
  "version": "2.0.0-rc.0",
  "private": false,
  "description": "TypeScript SDK for Zoho Inventory Rest API.",
  "homepage": "https://github.com/matagaralph/zapi-inventory#readme",
  "bugs": {
    "url": "https://github.com/matagaralph/zapi-inventory/issues"
  },
  "license": "MIT",
  "author": "Ralph Mataga",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matagaralph/zapi-inventory.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@zapi-inventory/typegen": "workspace:*",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
